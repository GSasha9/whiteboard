{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whiteboard",
  "main": "./dist/server/server.mjs",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/browser",
    "run_worker_first": true,
  },
}
