{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whiteboard",
  "main": "./dist/server/server.mjs",
  "compatibility_date": "2026-11-23",

  "observability": {
    "enabled": true,
  },

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/browser",
    "run_worker_first": true,
  },

  "previews": {
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true,
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true,
      },
      "issue_detection": {
        "enabled": false,
      },
    },
  },
}
