{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": ["stylelint-order"],
  "rules": {
    "order/properties-order": [
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "flex",
      "flex-direction",
      "align-items",
      "justify-content",
      "width",
      "height",
      "margin",
      "padding",
      "border",
      "background",
      "color",
      "font-size",
      "font-weight",
      "line-height",
      "text-align",
      "opacity",
      "transform",
      "transition"
    ],
    "selector-class-pattern": "^[a-z][a-z0-9-]*$"
  }
}
